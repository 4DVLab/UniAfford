{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: 调试数据集分割",
            "type": "debugpy",
            "program": "utils/base_dataset.py",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "console": "integratedTerminal",
            "args": [
                "-d", "/mnt/data/datasets/UniAfford/merged1-2-3",
                "--save-split",
            ],
        },
        {
            "name": "Python: 调试RAGNet数据集",
            "type": "debugpy",
            "program": "utils/external_datasets_processing.py",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "console": "integratedTerminal",
            "args": [
                "-m", "img", "ins",
                "-i", "/mnt/data/datasets/RAGNet",
                "-o", "/mnt/data/datasets/UniAfford/3_RAGNet/",
                "-d", "RAGNet",
                "-info", "/mnt/data/datasets/UniAfford/2_PIADv2/info.json"
            ],
        },
        {
            "name": "Python: 调试AGPIL数据集",
            "type": "debugpy",
            "program": "utils/external_datasets_processing.py",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "console": "integratedTerminal",
            "args": [
                "-m", "pc",
                "-i", "/mnt/data/datasets/AGPIL/AGPIL",
                "-o", "/mnt/data/datasets/UniAfford/1_AGPIL/",
                "-d", "AGPIL",
            ],
        },  
        {
            "name": "Python: 调试PIADv2数据集",
            "type": "debugpy",
            "program": "utils/external_datasets_processing.py",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "console": "integratedTerminal",
            "args": [
                "-m", "pc",
                "-i", "/mnt/data/datasets/PIADv2 (GREAT)",
                "-o", "/mnt/data/datasets/UniAfford/2_PIADv2/",
                "-d", "PIADv2",
                "-info", "/mnt/data/datasets/UniAfford/1_AGPIL/info.json"
            ],
        }, 
        {
            "name": "Python 调试程序: 包含参数的当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "${command:pickArgs}"
            ]
        }
    ]
}