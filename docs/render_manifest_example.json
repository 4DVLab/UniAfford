{
  "dataset_root": "../dataset",
  "output_dir": "../outputs/rendered_targets",
  "output": {
    "mode": "both",
    "grid": {
      "columns": 4,
      "rows": null,
      "cell_width": 800,
      "cell_height": 800,
      "padding": 12,
      "background": [255, 255, 255]
    }
  },
  "render": {
    "image": {
      "alpha": 0.5,
      "color_rgb": [255, 0, 0],
      "threshold": 0.0,
      "extension": ".jpg"
    },
    "point_cloud": {
      "backend": "realistic",
      "size": 800,
      "elev": 30,
      "azim": 45,
      "point_size": 12,
      "sphere_radius": 0.024,
      "sphere_resolution": 8,
      "max_points": 6000,
      "background": [255, 255, 255],
      "ground_plane": true,
      "extension": ".jpg"
    }
  },
  "images": [
