{
  "dataset_root": "../dataset",
  "output_dir": "../outputs/rendered_targets",
  "output": {
    "mode": "both",
    "grid": {
      "columns": 4,
      "rows": null,
      "cell_width": 800,
      "cell_height": 800,
      "padding": 12,
      "background": [255, 255, 255]
    }
  },
  "render": {
    "image": {
      "alpha": 0.5,
      "color_rgb": [255, 0, 0],
      "threshold": 0.0,
      "extension": ".jpg"
    },
    "point_cloud": {
      "backend": "iagnet",
      "size": 800,
      "fov": 25,
      "camera_origin": [3, 3, 3],
      "point_size": 12,
      "sphere_radius": 0.018,
      "sphere_resolution": 8,
      "max_points": 6000,
      "base_color_rgb": [190, 190, 190],
      "affordance_color_rgb": [255, 0, 0],
      "background": [255, 255, 255],
      "ground_plane": true,
      "extension": ".jpg",
      "iagnet": {
        "size": 800,
        "sample_count": 256,
        "fov": 25,
        "sphere_radius": 0.018,
        "max_points": 2048,
        "camera_origin": "3,3,3",
        "radiance": 6,
        "background_radiance": 0.0,
        "ground_scale": 100.0,
        "run_mitsuba": true,
        "convert_jpg": true,
        "mitsuba_renderer": "python",
        "mitsuba_variant": "cuda_ad_rgb",
        "exr_wait_timeout": 60.0,
        "exr_wait_interval": 0.25
      }
    }
  },
  "images": [
    {
      "name": "spoon_grasp_img120",
      "obj_type": "Spoon",
      "img_id": 120,
      "aff": "grasp"
    },
    {
      "name": "spoon_hold_img431",
      "obj_type": "Spoon",
      "img_id": 431,
      "aff": "hold"
    }
  ],
  "point_clouds": [
    {
      "name": "spoon_wrapgrasp_pc186",
      "obj_type": "Spoon",
      "pc_id": 186,
      "aff": "wrapgrasp"
    },
    {
      "name": "spoon_contain_pc203",
      "obj_type": "Spoon",
      "pc_id": 203,
      "aff": "contain"
    }
  ]
}
